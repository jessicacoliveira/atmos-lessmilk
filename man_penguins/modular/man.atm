val pico = require "pico"
val Motion = require "motion"
val map = require "map"

func between (lower, value, higher){
    ifs {
        value < lower  => lower
        value > higher => higher
        else => value
    }
}

val man = pico.layer.images [ mode='!', key=:man, path="media/player.png", sheet=[ '#', w = 3, h = 1 ] ]
task Man (){
    val rect = [ '%', x = 0.5, y = 0.5, w = MAN.w, h = MAN.h, anchor = 'NW' ]

    set pub = [
        rect = rect
    ]

    val speed, jump_v, gravity = (MAN.speed/WIN_W, MAN.jump/WIN_H, MAN.gravity/WIN_H)
    val rot = [ angle = 0 ]
    var vx, vy = (0, 0)
    var dir, frame = (1, 1)

    par:any {
        loop{
            val evt = await :key.dn until ((it.key == :Left) || (it.key == :Right))
            set vx = speed
            set dir = if evt.key == :Left => -1 => 1
            await :key.up until (it.key == evt.key)
            set vx = 0
        }
    } with {
        loop{
            val evt = await :key.dn until ((it.key == :Left) || (it.key == :Right))
            watching :key.up [key=evt.key]{
                loop{
                    set frame = ((frame - 1) % 2) + 2
                    await (MAN.anim)
                }
            }
            set frame = 1
        }
    } with {
        ;; jump
        loop on :key.dn [key=:Up]{
            par:any {
                await until (grounded(rect))
                pico.output.sound("media/jump.wav")
                set vy = jump_v
            } with {
                await (MAN.jump_buffer)
            }
        }
    } with {
        loop on :key.up [key=:Up]{
            if vy < 0 => set vy = vy * MAN.jump_cut
        }
    } with {
        loop on :bounce {
            set vy = jump_v/2
        }
    } with {
        ;; tile collision
        loop us on :clock {
            val dt = us / 1s

            ;; horizontal
            val new_x = between(0, rect.x + ((vx * dir) * dt), 1 - rect.w)
            if hit(map, new_x, rect.y, rect.w, rect.h, BRICK) == false => set rect.x = new_x

            ;; vertical
            set vy = vy + (gravity * dt)
            val new_y = rect.y + (vy * dt)
            if hit(map, rect.x, new_y, rect.w, rect.h, BRICK) => set vy = 0 => set rect.y = new_y
        }
    } with {
        loop on :draw {
            pico.set.layer(man@frame)
            val flip_var = if dir < 0 => "horizontal" => "none"
            pico.set.effect [ flip = flip_var, rotate = [angle = rot.angle, anchor='C' ] ]
            pico.set.layer(:actors)
            pico.output.draw.layer(man@frame, rect)
            pico.set.layer(:world)
        }
    } with {
        await until (rect.y > 1)
    } with {
        await :hit
        par:all{
            await Motion.linear(rect, [ y = 1 ], MAN.fall)
        } with {
            await Motion.linear(rot, [ angle = 360 ], MAN.spin)
        }
    }
}

Man
